<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="FurnitureBase">
    <defName>ElectricBrazier</defName>
    <label>electric brazier</label>
    <description>An electricity-powered brazier. Looks and feels like the real thing.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.15</fillPercent>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
    <selectable>true</selectable>
    <designationCategory>Furniture</designationCategory>
    <uiIconOffset>(0, -0.04)</uiIconOffset>
    <minifiedDef>MinifiedThing</minifiedDef>
	<building>
		<paintable>true</paintable>
	</building>
    <stuffCategories>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
      <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>90</basePowerConsumption>
      </li>
      <li Class="EB.CompProperties_ToggleGlower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>2</heatPerSecond>
        <heatPushMaxTemperature>20</heatPushMaxTemperature>
      </li>
      <li Class="EB.CompProperties_PoweredFireOverlay">
        <fireSize>1</fireSize>
        <offset>(0,0,0.18)</offset>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.13</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
			  <li>ElectricBrazier</li>
              <li>HolographicBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <offsetPerBuilding>0.02</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <canOverlapZones>false</canOverlapZones>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
      <li>Electricity</li>
    </researchPrerequisites>
    <graphicData>
      <!--<texPath>Things/Building/Misc/Brazier</texPath>-->
      <texPath>Things/Building/Misc/ElectricBrazier</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <shadowData>
        <volume>(0.55, 0.35, 0.3)</volume>
        <offset>(0, 0, -0.28)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.3,0.6,0.6)</rect>
      </damageData>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="FurnitureBase">
    <defName>HolographicBrazier</defName>
    <label>holographic brazier</label>
    <description>A floor-mounted emitter that projects a flickering hologram of a lit brazier. It gives light and counts as a brazier for royal rooms and meditation, but gives off no heat. The emitter is flush with the floor, so anyone may walk across it freely.</description>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>6</Mass>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
    <selectable>true</selectable>
    <designationCategory>Furniture</designationCategory>
    <uiIconPath>Things/Building/Misc/HolographicBrazier/HoloBrazier_MenuIcon</uiIconPath>
    <minifiedDef>MinifiedThing</minifiedDef>
    <costList>
      <Steel>10</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <placeWorkers>
      <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>90</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="EB.CompProperties_ToggleGlower">
        <glowRadius>10</glowRadius>
        <glowColor>(150,210,255,0)</glowColor>
        <normalColor>(150,210,255,0)</normalColor>
      </li>
      <li Class="EB.CompProperties_HoloBrazier">
        <bodyTexPath>Things/Building/Misc/HolographicBrazier/HoloBody_south</bodyTexPath>
        <flameTexPaths>
          <li>Things/Building/Misc/HolographicBrazier/HoloFlameA</li>
          <li>Things/Building/Misc/HolographicBrazier/HoloFlameB</li>
          <li>Things/Building/Misc/HolographicBrazier/HoloFlameC</li>
        </flameTexPaths>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes><li>Flame</li></focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.13</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li>ElectricBrazier</li>
              <li>HolographicBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <offsetPerBuilding>0.02</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>EB_HolographicBraziers</li>
    </researchPrerequisites>
    <graphicData>
      <texPath>Things/Building/Misc/HolographicBrazier/ProjectorDisc</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
