<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 runs on .NET 10 (WaylithCLR). Game DLLs live in the RimWorld install root,
    and UnityEngine types come from the game's UnityStubs.dll.
    Harmony 3 is supplied at runtime by the Harmony mod (brrainz.harmony) - never ship 0Harmony.dll.

    Build:  dotnet build -c Release      (output goes to ..\Assemblies)
    Override paths if needed:  dotnet build -c Release -p:RimWorldDir="D:\Games\RimWorld"
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ElectricBrazier</AssemblyName>
    <RootNamespace>EB</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Source -> 1.7 -> mod folder -> Mods -> RimWorld -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(RimWorldDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**;packages\**;.vs\**" />
    <None Remove="obj\**;packages\**;.vs\**" />
  </ItemGroup>
</Project>
